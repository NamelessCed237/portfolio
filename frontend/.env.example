# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Neon (PostgreSQL). Server side only: it is read by the functions in api/ and
# by the seed script, and never reaches the browser bundle. Do NOT prefix it
# with VITE_, that would publish it to every visitor.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Admin sign-in. Store the SHA-256 of your password, not the password:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# EmailJS — https://dashboard.emailjs.com/
# These are public by design (they ship in the bundle); the template must
# expose the variables: name, email, message.
# ---------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
