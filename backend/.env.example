# Neon Postgres connection string (https://neon.tech)
# Use the POOLED connection string for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Single admin credentials (used to log in to /admin)
ADMIN_EMAIL="admin@bikecedric.dev"
ADMIN_PASSWORD="change-me-strong-password"

# Secret used to sign JWT tokens — set a long random value
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# API server port and allowed frontend origin (CORS)
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
