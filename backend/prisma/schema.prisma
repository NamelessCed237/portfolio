// Prisma schema for the portfolio admin CMS (Neon Postgres)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Bilingual text is stored as JSON: { "fr": "...", "en": "..." }

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  year        String
  category    Json // { fr, en }
  role        Json // { fr, en }
  tagline     Json // { fr, en }
  description Json // { fr, en }
  highlights  Json // { fr: string[], en: string[] }
  stack       String[]
  liveUrl     String?
  githubUrl   String?
  cover       String
  gallery     String[]
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  icon      String?
  level     Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       Json // { fr, en }
  description Json // { fr, en }
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Experience {
  id          String   @id @default(cuid())
  kind        String   @default("work") // "work" | "education"
  title       Json // { fr, en }
  company     String
  location    String?
  period      String
  description Json // { fr, en }
  tags        String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       Json // { fr, en }
  excerpt     Json // { fr, en }
  content     Json // { fr, en } (markdown/html)
  cover       String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}
