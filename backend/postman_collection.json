                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.url) {",
                  "    const parts = data.url.split('/');",
                  "    pm.collectionVariables.set('uploadId', parts[parts.length - 1]);",
                  "  }",
                  "}"
                ]
